    "sass": "^1.93.2",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^4.9.5",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "scripts": {
    "dev:build": "tsup --watch",
    "build": "tsup",
    "demo": "webpack serve --mode development",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "prepare": "npm run build",
    "ts": "tsc --noEmit"
